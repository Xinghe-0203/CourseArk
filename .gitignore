# 运行数据：账号、设置、任务、日志、答题缓存（网页版在项目 data/，桌面版在 %APPDATA%）
data/
cli_copy/config.yml
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
logs/

# 本地环境与缓存
.venv/
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
frontend/*.tsbuildinfo
node_modules/

# 构建产物
desktop/build/
desktop/dist/
desktop/.cache/

# 界面验收截图（tools/vue_check.py 与 tools/ui_check.py 生成）
docs/vue-validation/

